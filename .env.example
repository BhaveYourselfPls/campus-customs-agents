# Copy to .env in this folder (or any parent) and fill in.
# .env is gitignored — never commit the real key.

# Portkey gateway key. Required: every agent call goes through it.
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides.
# MODEL_NAME=gpt-5.6-luna
